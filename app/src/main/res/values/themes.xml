<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose paints the entire UI; this theme only governs the window before the
      first frame. Parented on the platform theme so no appcompat dependency is needed.
    -->
    <style name="Theme.Creds" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
